# ── LLM Providers ──────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Observability ──────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=pulseagent

# ── Database (Supabase / SQLite) ───────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OAuth: Gmail ────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# ── OAuth: Notion ───────────────────────────────
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8000/auth/notion/callback

# ── OAuth: Jira (Atlassian) ─────────────────────
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/auth/jira/callback
JIRA_CLOUD_SITE_URL=

# ── Confirmation emails for risky actions ──────
SENDGRID_API_KEY=
CONFIRMATION_EMAIL_FROM=

# ── App config ──────────────────────────────────
ENVIRONMENT=development
SESSION_SECRET=dev-session-secret-change-in-production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
